{
  // The publish build. Standalone (no root extends) so the public-repo export builds the same way;
  // the monorepo type-check still covers src/ through the root tsconfig.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM for the Fetch API (fetch, Request, Response, Headers, URL) that API mode and ./server use; Node >= 22 and
    // browsers both provide it at runtime.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  // Tests and the core-parity suite never ship (src/__internal__ imports @bankr/core).
  "exclude": ["src/**/*.test.ts", "src/__internal__/**"]
}
