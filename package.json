{
  "name": "@bankr/launch-sdk",
  "version": "0.1.0-alpha.0",
  "description": "Launch tokens from your own wallet on Bankr's Uniswap v4 hook, on Bankr's launchpad or your own, with fees to holders and every launch indexed by Bankr.",
  "type": "module",
  "license": "MIT",
  "author": "Bankr",
  "homepage": "https://github.com/BankrBot/launch-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BankrBot/launch-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/BankrBot/launch-sdk/issues"
  },
  "keywords": [
    "bankr",
    "launch",
    "token",
    "launchpad",
    "uniswap-v4",
    "base",
    "robinhood",
    "arbitrum",
    "viem"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "bun run clean",
    "clean": "rm -rf dist",
    "test": "bun test",
    "smoke": "node scripts/smoke-node-import.mjs"
  },
  "peerDependencies": {
    "viem": "^2.57.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "viem": "^2.57.8"
  }
}
