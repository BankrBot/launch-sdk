{
  "name": "@bankr/launch-sdk",
  "version": "1.0.0-alpha.0",
  "description": "Run your own launchpad on Bankr's Uniswap v4 hook with your own parameters, and launch tokens on it from your own wallet, with fees to holders, on Base, Robinhood, Arbitrum, Arc, Ethereum and BNB Chain.",
  "type": "module",
  "license": "MIT",
  "author": "Bankr",
  "homepage": "https://github.com/BankrBot/launch-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BankrBot/launch-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/BankrBot/launch-sdk/issues"
  },
  "keywords": [
    "bankr",
    "launch",
    "token",
    "launchpad",
    "uniswap-v4",
    "base",
    "robinhood",
    "arbitrum",
    "arc",
    "ethereum",
    "bnb",
    "viem"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "bun run clean",
    "clean": "rm -rf dist",
    "test": "bun test",
    "smoke": "node scripts/smoke-node-import.mjs"
  },
  "peerDependencies": {
    "viem": "^2.57.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "viem": "^2.57.8"
  }
}
